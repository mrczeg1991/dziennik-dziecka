---
import Welcome from "@/components/Welcome.astro";
import Layout from "@/layouts/Layout.astro";
import NotesApp from "@/components/notes/NotesApp";

const { user } = Astro.locals;
---

<Layout>
  {user ? (
    <div class="bg-cosmic min-h-screen p-4 text-white">
      <div class="mx-auto max-w-2xl">
        <div class="flex flex-col gap-4 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Dashboard
            </h1>
            <p class="mt-1 text-sm text-blue-100/80">
              Welcome, <span class="font-semibold text-white">{user.email}</span>
            </p>
          </div>
          <form method="POST" action="/api/auth/signout">
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Sign out
            </button>
          </form>
        </div>

        <div class="mt-6 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
          <h2 class="mb-4 text-lg font-semibold text-white">My notes</h2>
          <NotesApp client:load />
        </div>
      </div>
    </div>
  ) : (
    <Welcome />
  )}
</Layout>
