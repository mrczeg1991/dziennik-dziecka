---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-lg rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-4xl font-bold text-transparent">
        Dziennik dziecka
      </h1>
      <p class="mb-8 text-blue-100/70">
        Zapisuj drobne fakty o dziecku — pomiary, objawy, pierwsze razy — i odnajduj je wtedy, gdy są potrzebne.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:justify-center">
        <a
          href="/auth/signin"
          class="inline-flex items-center justify-center rounded-lg bg-purple-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-purple-500"
        >
          Zaloguj się
        </a>
        <a
          href="/auth/signup"
          class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-white/10"
        >
          Zarejestruj się
        </a>
      </div>
    </div>
  </div>
</Layout>
