---
import Layout from "@/layouts/Layout.astro";
import AddNoteForm from "@/components/notes/AddNoteForm";
import NoteItem from "@/components/notes/NoteItem";
import { ServerError } from "@/components/auth/ServerError";
import { createClient } from "@/lib/supabase";
import { getChild, type Child } from "@/lib/children";
import { listNotes, type Note } from "@/lib/notes";
import { searchNotes } from "@/lib/search";
import { formatWallClock } from "@/lib/wall-clock";

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const id = Astro.params.id ?? "";
// An error can come from adding, editing or deleting, so the page owns its display rather
// than any one form.
const error = Astro.url.searchParams.get("error");

// The two 503 responses below are written out rather than shared through a helper: every use
// of such a helper sits after a top-level `return`, which the Astro language server's scope
// analysis loses track of, reporting it as unused on every `astro check`.

// A malformed id never reaches the database. An unknown child and one belonging to another
// account are both a plain 404, so the page is indistinguishable from one that never existed.
if (!UUID_RE.test(id)) {
  return new Response(null, { status: 404 });
}

// Unreachable in practice: /children is protected and without Supabase there is no signed-in
// user for the middleware to let through.
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  return new Response("Nie udało się wczytać strony. Spróbuj ponownie.", {
    status: 503,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}

// A page that cannot be served is not a page that does not exist: a 404 here would tell the
// parent their child is gone because the database was briefly unreachable. Only a null result
// — an unknown child, or one belonging to another account — is a 404.
let child: Child | null;
try {
  child = await getChild(supabase, id);
} catch {
  return new Response("Nie udało się wczytać strony. Spróbuj ponownie.", {
    status: 503,
    headers: { "content-type": "text/plain; charset=utf-8" },
  });
}
if (!child) {
  return new Response(null, { status: 404 });
}

// A failed query must never be shown as "no notes".
let notes: Note[] = [];
let listFailed = false;
try {
  notes = await listNotes(supabase, child.id);
} catch {
  listFailed = true;
}

// Trimmed so a whitespace-only query behaves like no query, matching the empty-string case
// below -- neither one reaches searchNotes. No top-level `return` here (see the Astro
// frontmatter lesson covering this file): everything folds into these three `let`s instead.
const searchQuery = Astro.url.searchParams.get("q")?.trim() ?? "";
let searchResults: Note[] = [];
let searchDegraded = false;
let searchFailed = false;
if (searchQuery) {
  try {
    const search = await searchNotes(supabase, child.id, searchQuery);
    searchResults = search.results;
    searchDegraded = search.degraded;
  } catch {
    searchFailed = true;
  }
}
---

<Layout title={child.name}>
  <div class="bg-cosmic flex min-h-screen justify-center p-4">
    <div class="w-full max-w-2xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <a href="/dashboard" class="mb-4 inline-block text-sm text-blue-100/70 transition-colors hover:text-blue-100">
        &larr; Moje dzieci
      </a>
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-3xl font-bold text-transparent">
        {child.name}
      </h1>

      <h2 class="mb-3 text-lg font-semibold text-blue-100">Dodaj notatkę</h2>
      <AddNoteForm childId={child.id} client:load />

      {error && (
        <div class="mt-6">
          {/* Same panel the auth forms and the dashboard use; static, nothing here is interactive. */}
          <ServerError message={error} />
        </div>
      )}

      <h2 class="mt-6 mb-3 text-lg font-semibold text-blue-100">Zapytaj o notatki</h2>
      {/* Plain GET form reloading this same page -- no fetch-based island exists anywhere in this
          codebase, and a question is just another way to arrive at `/children/<id>`. */}
      <form method="GET" action={`/children/${child.id}`} class="mb-4 flex gap-2">
        <input
          type="text"
          name="q"
          value={searchQuery}
          placeholder="np. Co jadła w zeszłym tygodniu?"
          class="w-full rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white placeholder-white/40 transition-colors focus:ring-2 focus:ring-purple-400 focus:outline-none"
        />
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500"
        >
          Szukaj
        </button>
      </form>

      {searchQuery && (
        <div class="mb-6 space-y-3">
          {searchFailed ? (
            <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
              Nie udało się wyszukać notatek. Odśwież stronę.
            </p>
          ) : (
            <div class="space-y-3">
              {searchDegraded && (
                <p class="rounded-lg border border-amber-400/30 bg-amber-900/20 px-3 py-2 text-xs text-amber-200">
                  wyszukiwanie częściowo niedostępne — wyniki tylko tekstowe
                </p>
              )}
              {searchResults.length === 0 ? (
                <p class="text-center text-blue-100/70">Brak notatek pasujących do pytania.</p>
              ) : (
                <ul class="space-y-3">
                  {searchResults.map((note) => (
                    <li>
                      {/* Links down to the same note in the full list below -- see the matching `id` there. */}
                      <a
                        href={`#note-${note.id}`}
                        class="block rounded-lg border border-white/10 bg-white/5 px-4 py-3 transition-colors hover:bg-white/10"
                      >
                        <p class="mb-2 text-xs text-blue-100/60">{formatWallClock(note.occurred_at)}</p>
                        <p class="break-words whitespace-pre-wrap">{note.content}</p>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      )}

      <h2 class="mt-6 mb-3 text-lg font-semibold text-blue-100">Notatki</h2>
      {listFailed ? (
        <p class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
          Nie udało się wczytać notatek. Odśwież stronę.
        </p>
      ) : notes.length === 0 ? (
        <p class="text-center text-blue-100/70">Nie dodano jeszcze żadnej notatki.</p>
      ) : (
        <ul class="space-y-3">
          {notes.map((note) => (
            <li id={`note-${note.id}`}>
              {/* Nothing in a row is interactive until the parent clicks "Edytuj" or "Usuń". */}
              <NoteItem note={note} childId={child.id} client:visible />
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</Layout>
