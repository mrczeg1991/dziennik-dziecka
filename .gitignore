# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# cloudflare
.dev.vars
.wrangler/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Vitest reporter output. The JSON reporter writes under this directory, and ESLint scope is
# .gitignore-driven -- an untracked, unignored output directory would move gate:scope's exact
# file count between runs.
.vitest/

# Git worktrees created by the 10x skill chain. These directories carry their own .git, so
# committing one records a gitlink with no .gitmodules entry -- which breaks any clone that
# initialises submodules. GitHub Actions did not notice (actions/checkout defaults to
# submodules: false); Cloudflare Workers Builds failed the clone outright.
.claude/worktrees/
